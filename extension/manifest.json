{
  "manifest_version": 3,
  "name": "Arc: read this page",
  "version": "0.3.0",
  "description": "Lets Arc read pages you open, from your own browser, so Arc can read them aloud. Arc never sees your password.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:3000/*", "https://arc-production-815e237c.up.railway.app/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "externally_connectable": { "matches": ["http://localhost:3000/*", "https://arc-production-815e237c.up.railway.app/*"] },
  "content_scripts": [
    { "matches": ["http://localhost:3000/*", "https://arc-production-815e237c.up.railway.app/*"], "js": ["arc-page.js"], "run_at": "document_start" }
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Read this page in Arc (Alt+Shift+A, Option+Shift+A on Mac)",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+A" }, "description": "Read this page in Arc" }
  },
  "options_page": "options.html"
}
