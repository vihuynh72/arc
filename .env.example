# Copy this file to .env.local and fill in the values. Never commit .env.local.
# With none of these set, `ARC_OFFLINE=1 npm run dev` still opens the bundled demo paper.

# Google Gemini: understands requests, answers questions aloud, describes figures, PDF pages and video.
GEMINI_API_KEY=

# Bright Data: fetches pages that block ordinary requests, runs a remote browser, and searches.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_BROWSER_WSS=

# Optional. See docs/deploy.md for the full list.
# ARC_KOKORO=off            # no local voice (small hosts); the Gemini voice reads instead
# ARC_DAILY_BUDGET_USD=2    # daily Gemini budget; the guard is on when NODE_ENV=production
# ARC_OFFLINE=1             # stored copies only, no live fetch
