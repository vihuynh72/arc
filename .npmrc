# onnxruntime-node (the runtime under the local Kokoro voice) tries to download GPU (CUDA) files when it is installed on Linux,
# and that download now fails with 404, which fails the whole `npm install`. Arc runs the voice on the CPU, so the GPU files are
# skipped. The package reads this setting itself (see its script/install.js).
onnxruntime-node-install-cuda=skip
