# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: only the example (names, no values) is kept
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local cache
.cache/

# private agent notes
CLAUDE.md
AGENTS.md
.impeccable/

# logs and screenshots of a CI e2e run (scripts/factory.mjs --ci --artifacts e2e-artifacts)
/e2e-artifacts/

# blind-student harness session logs
scripts/blind/logs/

# editor and merge leftovers
*.orig
